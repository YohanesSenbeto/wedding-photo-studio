{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@wedding/types": ["../../packages/types/src/index.ts"],
      "@wedding/validation": ["../../packages/validation/src/index.ts"],
      "@wedding/config": ["../../packages/config/src/index.ts"],
      "@wedding/config/server": ["../../packages/config/src/server/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "node_modules/.prisma/client/index.d.ts"],
  "exclude": ["node_modules"]
}
