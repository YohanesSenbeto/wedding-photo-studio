# Local Photoshop Agent configuration
# Copy to apps/photoshop-agent/.env

# Next.js server the agent talks to
SERVER_URL=http://localhost:3000

# Must match the server's AGENT_TOKEN
AGENT_TOKEN=change-me-to-a-long-random-secret

# Local HTTP/WebSocket service (browser connects here on the same machine)
AGENT_HTTP_PORT=47821
AGENT_HOST=127.0.0.1

# Where the agent downloads originals and writes exports
AGENT_WORKSPACE_PATH=./workspace

# AUTO = real Photoshop via COM on Windows
# DRYRUN = clearly-labelled pipeline test mode (NO Photoshop involvement)
AGENT_PHOTOSHOP_MODE=AUTO

# Poll interval for claiming jobs (ms)
JOB_POLL_INTERVAL_MS=2500

# Photoshop
PHOTOSHOP_VERSION=2022
PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop 2022\Photoshop.exe

# Watchdog
JOB_TIMEOUT_SECONDS=1200
MIN_FREE_DISK_MB=2048
