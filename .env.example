# ============================================================
# Wedding Photo Studio — environment variables
# Copy to .env (web app + prisma) and to apps/photoshop-agent/.env
# ============================================================

# --- Database (PostgreSQL) ---
# POSTGRES_PORT is the host port published by docker-compose.yml (container 5432).
# Keep it in sync with DATABASE_URL below.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding_studio?schema=public

# --- Shared secret used to authenticate the local Photoshop agent ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=change-me-to-a-long-random-secret

# --- URL the BROWSER uses to reach the LOCAL agent (same machine) ---
# The agent's local service binds to 127.0.0.1 only.
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:47821

# --- URL the AGENT uses to reach the Next.js server ---
# (used by the agent only; on one machine http://localhost:3000)
SERVER_URL=http://localhost:3000

# --- File storage (web app side). Must be absolute paths in production. ---
PHOTO_STORAGE_PATH=./storage/photos
OUTPUT_PATH=./storage/outputs

# --- Photoshop ---
PHOTOSHOP_VERSION=2022
PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop 2022\Photoshop.exe

# --- Local agent service ---
AGENT_HTTP_PORT=47821
AGENT_HOST=127.0.0.1
# Workspace where the agent downloads originals and writes exports
AGENT_WORKSPACE_PATH=./workspace
# AUTO (real Photoshop via COM on Windows) | DRYRUN (clearly-labelled pipeline test mode, NO Photoshop)
AGENT_PHOTOSHOP_MODE=AUTO
# Milliseconds between job claims from the server
JOB_POLL_INTERVAL_MS=2500

# --- Upload limits ---
MAX_JPG_UPLOAD_MB=40
MAX_ARW_UPLOAD_MB=200
