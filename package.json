  "private": true,
  "description": "Professional wedding photo editing studio — Next.js web app + local Windows Photoshop 2022 automation agent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @wedding/web",
